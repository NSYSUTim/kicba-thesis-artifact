[Unit]
Description=KICBA formal isolated multi-boot collection
After=local-fs.target network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/kicba/kicba
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/kicba/kicba/collector/run_multiboot_campaign.py --state /home/kicba/d2_formal/r1_state.json --output-root /home/kicba/d2_formal/r1 --caraxes-ko /opt/kicba/caraxes/caraxes.ko --project-root /home/kicba/kicba --total-boots 5 --rounds 30 --iterations 100 --isolated-vm-ack I_UNDERSTAND_THIS_LOADS_A_ROOTKIT_IN_AN_ISOLATED_VM
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
